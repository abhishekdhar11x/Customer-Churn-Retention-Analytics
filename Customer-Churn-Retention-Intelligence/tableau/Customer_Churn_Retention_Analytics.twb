      <column caption='Value Segment' datatype='string' name='[Calculation_3477937109925895]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [MonthlyCharges] &lt;= 50.4 THEN &quot;Low Value&quot;&#10;ELSEIF [MonthlyCharges] &lt;= 83.9 THEN &quot;Medium Value&quot;&#10;ELSE &quot;High Value&quot;&#10;END' />
